# Supabase project URL and public anon/publishable key (server and client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secrets. Never prefix secrets with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
INTEGRATION_ENCRYPTION_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Optional; configure model and input/output USD per million tokens to estimate cost.
# Also set the cached-input rate if usage reports cached tokens. Rates must match the exact model and context tier.
OPENAI_PRICING_MODEL=
OPENAI_INPUT_USD_PER_MILLION_TOKENS=
OPENAI_OUTPUT_USD_PER_MILLION_TOKENS=
OPENAI_CACHED_INPUT_USD_PER_MILLION_TOKENS=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
